{
  "name": "web-test-toolkit",
  "version": "0.2.1",
  "description": "Development workspace for the web-test-toolkit Claude Code plugin (plugins/web-test-toolkit/). Testers install the plugin; this package.json only serves unit tests and local runs.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "explore": "node plugins/web-test-toolkit/skills/test-designer/explore.mjs",
    "crawl": "node plugins/web-test-toolkit/skills/test-designer/crawl.mjs",
    "coverage": "node plugins/web-test-toolkit/skills/test-designer/coverage.mjs",
    "test": "playwright test --config plugins/web-test-toolkit/skills/test-runner/playwright.config.mjs",
    "test:unit": "node --test \"plugins/web-test-toolkit/skills/**/*.test.mjs\"",
    "gate": "node plugins/web-test-toolkit/skills/test-runner/report.mjs",
    "status": "node plugins/web-test-toolkit/skills/web-test/gate.mjs",
    "bugs": "node plugins/web-test-toolkit/skills/result-analyst/bugs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
